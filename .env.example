# tap-databricks configuration
# Copy to .env and fill in values. Use with:
#   tap-databricks --config=ENV --discover
#
# Env names: TAP_DATABRICKS_<SETTING_KEY> (uppercase).
# Authoritative schema: tap-databricks --about

# --- Required (config_jsonschema) ---

# Databricks workspace URL
TAP_DATABRICKS_API_URL="https://dbc-xxxx.cloud.databricks.com"

# OAuth service principal credentials
TAP_DATABRICKS_CLIENT_ID="your_client_id_here"
TAP_DATABRICKS_CLIENT_SECRET="your_client_secret_here"

# Databricks http path to use for the sync (e.g. /sql/1.0/warehouses/warehouse_id)
TAP_DATABRICKS_HTTP_PATH="/sql/1.0/warehouses/your_warehouse_id_here"

# --- Optional (config_jsonschema) ---

# OAuth scope (default: all-apis)
#TAP_DATABRICKS_OAUTH_SCOPE="all-apis"

# Earliest record date for incremental sync (ISO-8601; default: 2000-01-01T00:00:00Z)
#TAP_DATABRICKS_START_DATE="2000-01-01T00:00:00Z"

# --- Table selection (used in discover_streams) ---
# If unset, all accessible Unity Catalog tables are discovered.

# Option A: comma-separated fully qualified names (catalog.schema.table)
# Takes precedence over table_selection when both are set.
# TAP_DATABRICKS_TABLES="samples.bakehouse.media_customer_reviews,samples.bakehouse.sales_transactions"

# Option B: filter by catalog/schema, optionally with per-table metadata
# catalog + schema alone limit discovery to that schema (all tables).
TAP_DATABRICKS_CATALOG="samples"
TAP_DATABRICKS_SCHEMA="bakehouse"

# table_selection is a JSON array — awkward in .env; prefer config.json for this.
# Used with catalog + schema. Each entry can set name, replication_key, primary_key.
# TAP_DATABRICKS_TABLE_SELECTION='[{"name":"media_customer_reviews","replication_key":"review_date","primary_key":"new_id"}]'